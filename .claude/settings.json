{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["context7", "cloudflare-docs"],
  "permissions": {
    "allow": [
      "Bash(bun run check)",
      "Bash(bun run test)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run fmt)",
      "Bash(bun run fmt:check)",
      "Bash(bun run build)",
      "Bash(bun run dev)",
      "Bash(bun run e2e)",
      "Bash(bun run wasm:build)",
      "Bash(bun test:*)",
      "Bash(bun install)",
      "Bash(bun run --filter:*)",
      "Bash(bunx oxlint:*)",
      "Bash(bunx oxfmt:*)",
      "Bash(bunx prettier:*)",
      "Bash(bunx svelte-check:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(wasm-pack build:*)",
      "Bash(mise exec:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(wrangler deploy:*)",
      "Bash(bunx wrangler deploy:*)",
      "Bash(wrangler secret:*)",
      "Bash(bunx wrangler secret:*)",
      "Read(./apps/web/.dev.vars)",
      "Read(./.dev.vars)",
      "Read(./**/.env)"
    ]
  }
}
