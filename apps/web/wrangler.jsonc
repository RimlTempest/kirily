{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kirily-web",
  "compatibility_date": "2026-09-21",

  // Workers with static assets, not Pages. Pages is in maintenance and takes
  // no new features; this is where Cloudflare puts them (ADR-0024).
  //
  // `main` and `assets.directory` both point into the adapter's output. The
  // adapter reads this file to decide which of the two shapes to build, and
  // writes the `.assetsignore` that keeps `_worker.js` from also being served
  // as a static file.
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
  },

  // Cloudflare creates the DNS record and manages the certificate. Declared
  // here rather than clicked in the dashboard, so the domain this answers on
  // is part of the repository and a change to it shows up in a diff.
  "routes": [{ "pattern": "kirily.riml4i.com", "custom_domain": true }],

  // Spelled out, because adding `routes` already turns it off: wrangler infers
  // `workers_dev: false` when routes are present and says nothing about it.
  // The site had two addresses, then one, and nothing in this file recorded
  // the change. Now it does.
  //
  // Set it to true if a second address is wanted while DNS is settling; the
  // cost is two public URLs serving the same site.
  "workers_dev": false,

  // R2 / KV / D1 bindings are deliberately absent. The MVP processes images in
  // the browser and stores nothing (kirily-design.md §22, §43). Adding a
  // binding here means the privacy promise on the landing page has to change
  // too — CI checks for it.
}
